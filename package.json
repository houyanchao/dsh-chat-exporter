{
  "name": "dsh-chat-export",
  "version": "1.0.0",
  "description": "导出和截图插件，导出为 Markdown、TXT、JSON、CSV、PNG 或 PDF，也可生成高清截图。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh",
    "chat-export",
    "screenshot"
  ],
  "homepage": "https://github.com/houyanchao/dsh-chat-export#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houyanchao/dsh-chat-export.git"
  },
  "bugs": {
    "url": "https://github.com/houyanchao/dsh-chat-export/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown && tsc -p tsconfig.types.json",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "lightningcss": "1.33.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "temml": "0.13.4",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "unrun": "0.2.39"
  },
  "files": [
    "locale/*.json",
    "lib",
    "cordis.patch.yml",
    "README.en.md",
    "src/client/conversationExport/vendor/LICENSE",
    "src/client/conversationExport/vendor/Temml-LICENSE"
  ]
}
